# ===========================================
# LINE Harness - Environment Variables
# ===========================================
# For Worker: set via `wrangler secret put <NAME>`
# For Web: copy to apps/web/.env.local

# --- Worker (Cloudflare Workers) ---
# Set these with: wrangler secret put <NAME>
API_KEY=your-api-key
APP_ENCRYPTION_KEY=change-this-to-a-long-random-string
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
WORKER_URL=https://your-worker.workers.dev
WEB_URL=https://your-pages-project.pages.dev
LIFF_URL=https://liff.line.me/your-liff-id
DISCORD_WEBHOOK_URL=
DISCORD_RESERVATION_WEBHOOK_URL=
DISCORD_DAILY_WEBHOOK_URL=
DISCORD_REVIEW_WEBHOOK_URL=
DISCORD_RESERVATION_THREAD_ID=
DISCORD_DAILY_THREAD_ID=
DISCORD_REVIEW_THREAD_ID=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=reservation@example.com
RESEND_FROM_NAME=アオニサイファーム予約
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# --- Provider / Branding (public values; use GitHub Variables or Worker vars) ---
PROVIDER_ID=aonisai
PROVIDER_NAME=AONISAI FARM
PROVIDER_DISPLAY_NAME=アオニサイファーム ブルーベリー観光農園
PROVIDER_SHORT_NAME=アオニサイファーム
PROVIDER_DESCRIPTION=つくばの農園で、旬のブルーベリーとカフェを楽しめます。
PROVIDER_ADDRESS=〒300-2645 茨城県つくば市上郷 2223-1
PROVIDER_PHONE=
PROVIDER_SITE_URL=https://aonisai-blueberry.com/
PROVIDER_PRIMARY_COLOR=#272f72
PROVIDER_ACCENT_COLOR=#69A3D0
PROVIDER_BACKGROUND_COLOR=#fbfaf6
PROVIDER_TEXT_COLOR=#1c2440
PROVIDER_LOGO_URL=/aonisai/aonisai_blue.jpg
PROVIDER_HERO_IMAGE_URL=/aonisai/cafe/cafe-hero.webp
PROVIDER_FAVICON_URL=
BOOKING_TITLE=ブルーベリー体験予約
BOOKING_INTRO_TITLE=つくばの農園で、旬のブルーベリーを楽しむ体験
BOOKING_INTRO_BODY=日付を選んで、空いている時間枠から予約できます。
BOOKING_LINE_LINK_TITLE=LINEで予約確認
BOOKING_LINE_LINK_BODY=LINEで連携すると、予約確認やキャンセルが簡単になります。
BOOKING_ENABLE_CAFE_TAB=true
BOOKING_ENABLE_LINE_LINK_PANEL=true
EMAIL_FROM_NAME=アオニサイファーム予約
EMAIL_FOOTER_TEXT=アオニサイファーム ブルーベリー観光農園
EMAIL_HERO_IMAGE_URL=/aonisai/cafe/cafe-hero.webp
EXTERNAL_IMPORT_ENABLED=true
EXTERNAL_IMPORT_LABEL=じゃらん / Gmail設定
EXTERNAL_IMPORT_PROVIDER=jalan
EXTERNAL_IMPORT_DEFAULT_FROM_EMAIL=reservation@activityboard.jp,reservation_cancel@activityboard.jp
EXTERNAL_IMPORT_DEFAULT_QUERY={from:reservation@activityboard.jp from:reservation_cancel@activityboard.jp} newer_than:30d

# Optional: Cross-account linking
X_HARNESS_URL=https://your-other-harness.workers.dev

# --- Web App (Next.js Admin Dashboard) ---
# Copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=https://your-worker.workers.dev

# --- MCP Server ---
# Set in your MCP client config
LINE_HARNESS_API_URL=https://your-worker.workers.dev
LINE_HARNESS_API_KEY=your-api-key
LINE_HARNESS_ACCOUNT_ID=optional-account-id
