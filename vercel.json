{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/out",
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/api/admin/:path*"
    }
  ]
}
