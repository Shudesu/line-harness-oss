# LINE Messaging API
LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# LINE Login / LIFF
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret_here
LIFF_URL=https://liff.line.me/your-liff-id

# Admin API Key (generate a random string)
API_KEY=your_api_key_here

# Workers API URL (set after deploying worker)
NEXT_PUBLIC_API_URL=https://your-worker.your-subdomain.workers.dev

# Reservation defaults (local seed uses these IDs)
RESERVATION_DEFAULT_RESOURCE_ID=res_blueberry
RESERVATION_DEFAULT_MENU_ID=menu_blueberry_60
RESERVATION_GOOGLE_CALENDAR_CONNECTION_ID=gcal_reservation_default

# Google Calendar integration
# access_token is short-lived. For production, store/use refresh_token and refresh access_token server-side.
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=https://your-worker.your-subdomain.workers.dev/api/integrations/google-calendar/oauth/callback
GOOGLE_OAUTH_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_OAUTH_ACCESS_TOKEN=your_google_access_token_here

# Gmail / Jalan reservation import
GMAIL_OAUTH_CLIENT_ID=your_gmail_oauth_client_id_here
GMAIL_OAUTH_CLIENT_SECRET=your_gmail_oauth_client_secret_here
GMAIL_OAUTH_REFRESH_TOKEN=your_gmail_refresh_token_here
JALAN_IMPORT_SECRET=your_jalan_import_secret_here

# Web reservation confirmation email
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=reservation@example.com
RESEND_FROM_NAME=アオニサイファーム予約
